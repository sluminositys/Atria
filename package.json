{
  "name": "atria",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "A desktop-first HTML artifact workspace for AI-generated reports, block notes, and MCP-native agent integration.",
  "scripts": {
    "dev": "corepack pnpm --filter @atria/desktop dev",
    "desktop": "corepack pnpm --filter @atria/desktop tauri:dev",
    "build": "corepack pnpm -r --sort build",
    "typecheck": "corepack pnpm -r --sort typecheck",
    "test": "corepack pnpm -r --if-present test",
    "mcp": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/desktop/scripts/run-mcp.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
